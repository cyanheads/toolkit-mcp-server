# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=localhost           # HTTP host (default: localhost)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max request body bytes; 413 over limit, 0 disables (default: 1048576)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
# MCP_SESSION_MODE=stateful         # stateful | stateless (default: stateful)

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load (issue #50). Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP endpoint URL (e.g., http://localhost:4318)

# ── Server-specific ──────────────────────────────────────────────────
# All optional. The five always-on tools (hash, generate id, generate QR,
# encode, geolocate IP) need zero configuration. The two host-probing tools
# stay unregistered (absent from tools/list) until their flag is set.

# Register the gated toolkit_check_network tool (ping / traceroute /
# connectivity / public_ip). Leave off for hosted or shared deployments.
# TOOLKIT_ENABLE_NET_DIAGNOSTICS=false

# Register the gated toolkit_check_system tool (host OS / CPU / memory / load /
# interfaces). Meaningful only on a local or self-hosted deployment.
# TOOLKIT_ENABLE_SYSTEM_INFO=false

# Second gate: with net diagnostics on, permit private/reserved/loopback/
# link-local targets (incl. the cloud-metadata endpoint). Off blocks them.
# TOOLKIT_ALLOW_PRIVATE_NETWORK=false

# API key for the geolocation endpoint, if it requires one. The default tier is keyless.
# TOOLKIT_GEO_API_KEY=

# Base URL for an ip-api-compatible geolocation endpoint. The default is plaintext
# HTTP: ip-api's HTTPS endpoint is not part of the keyless free tier.
# TOOLKIT_GEO_BASE_URL=http://ip-api.com

# In-memory geolocation cache TTL in seconds. Geolocation is stable, so repeats are cached.
# TOOLKIT_GEO_CACHE_TTL_SECONDS=3600

# Max geolocation requests per minute. Default 45 matches the ip-api free tier.
# TOOLKIT_GEO_RATE_LIMIT_PER_MIN=45
