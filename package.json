{
  "name": "@cyanheads/toolkit-mcp-server",
  "version": "2.3.1",
  "mcpName": "io.github.cyanheads/toolkit-mcp-server",
  "description": "Generate random IDs, QR codes, and hashes, encode and decode values, and geolocate IPs, plus gated network and system diagnostics, via MCP. STDIO or Streamable HTTP.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "toolkit-mcp-server": "dist/index.js"
  },
  "files": [
    "changelog/",
    "dist/",
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    "AGENTS.md",
    "Dockerfile",
    "server.json"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "rebuild": "bun run scripts/clean.ts && bun run scripts/build.ts",
    "clean": "bun run scripts/clean.ts",
    "devcheck": "bun run scripts/devcheck.ts",
    "audit:fix": "bun audit fix",
    "audit:refresh": "rm -f bun.lock && bun install && bun audit",
    "tree": "bun run scripts/tree.ts",
    "list-skills": "bun run scripts/list-skills.ts",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "lint:mcp": "bun run scripts/lint-mcp.ts",
    "lint:packaging": "bun run scripts/lint-packaging.ts",
    "bundle": "bun run build && npx -y @anthropic-ai/mcpb pack . dist/toolkit-mcp-server.mcpb && bun run scripts/clean-mcpb.ts dist/toolkit-mcp-server.mcpb",
    "changelog:build": "bun run scripts/build-changelog.ts",
    "changelog:check": "bun run scripts/build-changelog.ts --check",
    "release:github": "bun run scripts/release-github.ts",
    "publish-mcp": "mcp-publisher login github -token \"$(security find-generic-password -a \"$USER\" -s mcp-publisher-github-pat -w)\" && mcp-publisher publish",
    "test": "vitest run",
    "start": "node dist/index.js",
    "start:stdio": "MCP_TRANSPORT_TYPE=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT_TYPE=http node dist/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "bun",
    "stdio",
    "streamable-http",
    "developer-tools",
    "utilities",
    "uuid",
    "ulid",
    "qr-code",
    "hashing",
    "encoding",
    "base64",
    "ip-geolocation",
    "network-diagnostics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/toolkit-mcp-server.git"
  },
  "homepage": "https://github.com/cyanheads/toolkit-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/cyanheads/toolkit-mcp-server/issues"
  },
  "author": "Casey Hand <casey@caseyjhand.com> (https://caseyjhand.com)",
  "license": "Apache-2.0",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/cyanheads"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://www.buymeacoffee.com/cyanheads"
    }
  ],
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cyanheads/mcp-ts-core": "^0.13.6",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "depcheck": "^1.4.7",
    "ignore": "^7.0.9",
    "tsc-alias": "^1.9.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
